{
	"name": "@zokugun/fs-path-sanitize",
	"description": "sanitize filesystem paths and path segments",
	"version": "0.1.0",
	"author": {
		"name": "Baptiste Augrain",
		"email": "daiyam@zokugun.org"
	},
	"license": "MIT",
	"homepage": "https://github.com/zokugun/node-fs-path-sanitize",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zokugun/node-fs-path-sanitize.git"
	},
	"bugs": {
		"url": "https://github.com/zokugun/node-fs-path-sanitize/discussions/categories/issue-triage"
	},
	"type": "module",
	"main": "lib/cjs/index.cjs",
	"module": "lib/esm/index.mjs",
	"scripts": {
		"audit": "better-npm-audit audit",
		"audit:fix": "npm audit fix --min-release-age=0",
		"build": "npm run clean && npm run build:lib && npm run build:out",
		"build:lib": "tsc-leda generate",
		"build:out": "tsc-leda generate",
		"build:package": "tsc-leda update-package && npm run lint:package",
		"ci:lint": "zizmor .",
		"ci:lint:fix": "zizmor . --fix=all",
		"clean": "rimraf .src .test lib",
		"compile:src": "tsc -p src",
		"compile:test": "tsc -p test",
		"lint": "xo; eslint",
		"lint:all": "npm run audit && npm run lint:package && npm run ci:lint",
		"lint:fix": "xo --fix; eslint --fix",
		"lint:package": "fixpack || true",
		"prepack": "npm run build",
		"prepare": "husky; npm run lint:package",
		"release": "release-it",
		"test": "vitest run --reporter tree",
		"test:coverage": "vitest run --reporter tree --coverage --coverage.reporter text",
		"test:ui": "vitest --ui --coverage",
		"test:watch": "vitest",
		"update:artifacts": "artifact update",
		"update:ci": "PINACT_MIN_AGE=7 pinact run --update -min-age 7 -update",
		"update:deps": "taze --all",
		"watch:build": "tsc-watch -p src --onSuccess 'npm run build'",
		"watch:src": "tsc-watch -p src",
		"watch:test": "tsc-watch -p test"
	},
	"dependencies": {
		"@zokugun/is-it-type": "0.8.1",
		"@zokugun/xtry": "0.11.6"
	},
	"devDependencies": {
		"@commitlint/cli": "20.5.3",
		"@commitlint/config-conventional": "20.5.3",
		"@types/node": "20.19.43",
		"@vitest/coverage-v8": "4.1.11",
		"@vitest/ui": "4.1.11",
		"@zokugun/eslint-config": "0.2.1",
		"@zokugun/eslint-config-data": "0.2.1",
		"@zokugun/eslint-config-glossary": "0.2.0",
		"@zokugun/eslint-config-js": "0.2.1",
		"@zokugun/eslint-config-md": "0.4.1",
		"@zokugun/eslint-config-nodejs": "0.2.0",
		"@zokugun/eslint-config-style": "0.3.1",
		"@zokugun/eslint-config-test": "0.2.0",
		"@zokugun/eslint-config-ts": "0.3.2",
		"@zokugun/fs-extra-plus": "0.6.2",
		"@zokugun/tsc-leda": "0.9.0",
		"better-npm-audit": "3.11.0",
		"eslint": "10.12.0",
		"fixpack": "4.0.0",
		"globby": "16.2.4",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"release-it": "20.2.1",
		"rimraf": "6.1.3",
		"taze": "19.17.2",
		"tsc-watch": "7.2.1",
		"typescript": "5.9.3",
		"vitest": "4.1.11",
		"yaml": "2.9.1"
	},
	"overrides": {
		"@octokit/request": {
			"content-type": "2.1.0"
		},
		"@inquirer/core": {
			"mute-stream": "3.0.0"
		},
		"get-uri": {
			"basic-ftp": "6.2.1"
		},
		"micromark-extension-math": {
			"katex": "0.18.2"
		},
		"release-it": {
			"undici": "7.30.0"
		},
		"vite": {
			"nanoid": "3.3.20"
		}
	},
	"allowScripts": {
		"@zokugun/cli-utils": true,
		"fsevents": true,
		"unrs-resolver": true
	},
	"keywords": []
}
